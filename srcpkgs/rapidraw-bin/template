do_install() {
	vinstall usr/bin/RapidRAW 755 usr/bin
	vcopy usr/lib/RapidRAW usr/lib
	vinstall usr/share/applications/RapidRAW.desktop 644 usr/share/applications
	vcopy usr/share/icons usr/share
	vlicense usr/lib/RapidRAW/resources/licenses/AGPL-3.0.txt
}
